# ─── Preview Mode ──────────────────────────────────────────
NUXT_PUBLIC_PREVIEW_MODE=false

# ─── Authentication ────────────────────────────────────────
NUXT_SITE_TOKEN=ShortyCool

# ─── Application ───────────────────────────────────────────
NUXT_PUBLIC_SLUG_DEFAULT_LENGTH=5
NUXT_REDIRECT_STATUS_CODE=308
NUXT_LINK_CACHE_TTL=60
NUXT_REDIRECT_WITH_QUERY=false
NUXT_HOME_URL=""
NUXT_DATASET=shorty

# ─── AI Slug Generation (OpenAI Compatible) ────────────────
# Set NUXT_OPENAI_API_KEY to enable AI-powered slug generation.
# Supports any OpenAI-compatible API (OpenAI, Groq, Together, Ollama, etc.)
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_BASE_URL=https://api.openai.com/v1
NUXT_AI_MODEL=gpt-4o-mini
NUXT_AI_PROMPT="You are a URL shortening assistant. Shorten the URL into a human-readable SLUG using information from the URL itself. Max 3 words. Return JSON: {\"slug\": \"example\"}"

# ─── Cloudflare (Optional — for Workers deployment) ────────
NUXT_CF_ACCOUNT_ID=
NUXT_CF_API_TOKEN=
NUXT_DISABLE_AUTO_BACKUP=false
